# Oak — non-secret configuration
# Secrets are stored in Dockhand

DOMAIN=cloudbyhomo.dk

OAK__APP__ENVIRONMENT=production
OAK__DATABASE__HOST=postgres-apps
OAK__DATABASE__PORT=5432
OAK__DATABASE__NAME=oak
OAK__DATABASE__USER=oak

# Secrets (set in Dockhand):
DB_PASSWORD=super-secret-postgres-password
MATTERMOST_WEBHOOK_URL=super-secret-webhook-url
